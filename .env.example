# ── Stripe ──
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Site ──
NEXT_PUBLIC_SITE_URL=https://lacebylaluz.com

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Admin / owner bootstrap ──
# Email of the person who gets owner role on first sign-in to /admin.
# Leave unset to let the first authenticated visitor take the chair.
LACE_OWNER_EMAIL=mom@example.com

# ── Email (Resend) ──
RESEND_API_KEY=re_...
# Sender shown on outbound emails (order confirmations, inbox replies).
LACE_FROM_EMAIL=orders@lacebylaluz.com
LACE_FROM_NAME=Lace by La Luz
# Optional: override the reply-to address.
LACE_REPLY_TO_EMAIL=

# ── AI (Claude) ──
ANTHROPIC_API_KEY=sk-ant-...

# ── Analytics (optional) ──
NEXT_PUBLIC_GA_ID=G-...
